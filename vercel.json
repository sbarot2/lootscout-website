{
  "framework": "nextjs",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lootscout.io" }],
      "destination": "https://www.lootscout.io/",
      "permanent": true
    },
    {
      "source": "/:rest((?!\\.well-known).+)",
      "has": [{ "type": "host", "value": "lootscout.io" }],
      "destination": "https://www.lootscout.io/:rest",
      "permanent": true
    }
  ]
}
